#!/bin/sh
set -eu

SOURCE=$0
while [ -L "$SOURCE" ]; do
    SOURCE_DIR=$(CDPATH='' cd -P -- "$(dirname -- "$SOURCE")" && pwd)
    LINK_TARGET=$(readlink "$SOURCE")
    case "$LINK_TARGET" in
        /*) SOURCE=$LINK_TARGET ;;
        *) SOURCE=$SOURCE_DIR/$LINK_TARGET ;;
    esac
done

SCRIPT_DIR=$(CDPATH='' cd -P -- "$(dirname -- "$SOURCE")" && pwd)
PROJECT_ROOT=$(dirname -- "$SCRIPT_DIR")
PYTHON_BIN=${HOMEKIT_INSPECTOR_PYTHON:-python3}

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
    echo "HomeKit Inspector requires Python 3.9 or later: $PYTHON_BIN not found" >&2
    exit 127
fi

if ! "$PYTHON_BIN" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)'; then
    echo "HomeKit Inspector requires Python 3.9 or later: $PYTHON_BIN" >&2
    exit 2
fi

exec "$PYTHON_BIN" "$PROJECT_ROOT/scripts/homekit_inspector_cli.py" "$@"
